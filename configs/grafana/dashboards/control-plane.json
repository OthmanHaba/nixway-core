{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["nixway", "control-plane"],
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "Nixway Control Plane",
  "uid": "nixway-control-plane",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets up",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "expr": "up{job=~\"nixway-.*|traefik|postgres|redis\"}", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API request rate (by status code)",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "sum by (code) (rate(nixway_http_requests_total[5m]))", "legendFormat": "{{code}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API latency p95 (by method)",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, method) (rate(nixway_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{method}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Container CPU (cores)",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Container memory (working set)",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\"})", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Worker jobs (by kind / status)",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "sum by (kind, status) (rate(nixway_worker_jobs_total[5m]))", "legendFormat": "{{kind}} {{status}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Postgres / Redis health",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "pg_up", "legendFormat": "postgres up" },
        { "refId": "B", "expr": "redis_up", "legendFormat": "redis up" },
        { "refId": "C", "expr": "sum(pg_stat_activity_count)", "legendFormat": "pg connections" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Log volume (by level)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "logs", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "targets": [
        { "refId": "A", "expr": "sum by (level) (count_over_time({project=\"nixway-core\"} [1m]))", "legendFormat": "{{level}}" }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Control-plane logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 20 },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [
        { "refId": "A", "expr": "{project=\"nixway-core\"} | json", "legendFormat": "" }
      ]
    }
  ]
}
