{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "test:integration": {
      "cache": false
    },
    "lint": {},
    "generate": {
      "outputs": ["internal/db/*.go", "proto/agent/v1/*.go"]
    }
  }
}
