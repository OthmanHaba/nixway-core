# Database
NIXWAY_DATABASE_URL=postgres://postgres@localhost:5432/nixway_core?sslmode=disable

# Redis
NIXWAY_REDIS_URL=redis://localhost:6379/0

# Server
NIXWAY_SERVER_HOST=0.0.0.0
NIXWAY_SERVER_PORT=8080
NIXWAY_SERVER_GRPC_PORT=9090
NIXWAY_SERVER_AGENT_BINARY_DIR=apps/agent/bin
# NIXWAY_SERVER_PUBLIC_URL=  # Set to your tunnel URL or public domain

# Crypto (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
NIXWAY_CRYPTO_MASTER_KEY=

# Auth
NIXWAY_AUTH_BCRYPT_COST=12
NIXWAY_AUTH_SESSION_TTL=24h

# Email
NIXWAY_EMAIL_DRIVER=console
NIXWAY_EMAIL_FROM=noreply@nixway.dev
NIXWAY_EMAIL_BASE_URL=http://localhost:5173
# NIXWAY_EMAIL_SMTP_HOST=
# NIXWAY_EMAIL_SMTP_PORT=587
# NIXWAY_EMAIL_SMTP_USER=
# NIXWAY_EMAIL_SMTP_PASS=

# Platform storage (MinIO by default; backs Phase 8.7 backups)
NIXWAY_PLATFORMSTORAGE_ENDPOINT=http://localhost:9000
NIXWAY_PLATFORMSTORAGE_BUCKET=nixway-backups
NIXWAY_PLATFORMSTORAGE_REGION=us-east-1
NIXWAY_PLATFORMSTORAGE_USESSL=false
NIXWAY_PLATFORMSTORAGE_PROVIDER=minio
NIXWAY_PLATFORMSTORAGE_ACCESSKEY=
NIXWAY_PLATFORMSTORAGE_SECRETKEY=
