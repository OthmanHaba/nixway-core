# Database
NIXWAY_POSTGRES_PORT=5432
NIXWAY_POSTGRES_DB=nixway_core
NIXWAY_POSTGRES_USER=nixway
NIXWAY_POSTGRES_PASSWORD=nixway-dev-secret-change-me
NIXWAY_DATABASE_URL=postgres://nixway:nixway-dev-secret-change-me@postgres:5432/nixway_core?sslmode=disable

# Redis
NIXWAY_REDIS_PORT=6379
NIXWAY_REDIS_URL=redis://redis:6379/0

# Server
NIXWAY_WEB_PORT=5173
NIXWAY_SITE_PORT=5373
NIXWAY_API_PORT=8080
NIXWAY_GRPC_PORT=9090
NIXWAY_HTTP_PORT=80
NIXWAY_HTTPS_PORT=443
NIXWAY_PUBLIC_DOMAIN=
NIXWAY_SERVER_HOST=0.0.0.0
NIXWAY_SERVER_PORT=8080
NIXWAY_SERVER_GRPC_PORT=9090
NIXWAY_SERVER_AGENT_BINARY_DIR=/app/agent/bin
NIXWAY_SERVER_PUBLIC_URL=http://localhost:8080
# Optional: raw host (e.g. EC2 IP) agents should dial for gRPC. Use this when
# NIXWAY_SERVER_PUBLIC_URL is a Cloudflare-proxied domain (Cloudflare proxy
# does not forward port 9090). Falls back to the host of PUBLIC_URL when empty.
NIXWAY_SERVER_AGENT_GRPC_HOST=

# Traefik / HTTPS reverse proxy
# Set NIXWAY_PUBLIC_DOMAIN to enable Traefik during deploy.
NIXWAY_TRAEFIK_ACME_EMAIL=
NIXWAY_TRAEFIK_LOG_LEVEL=INFO
NIXWAY_TRAEFIK_ACCESS_LOG=false
NIXWAY_DOCKER_PUBLIC_NETWORK=nixway-public
NIXWAY_DOCKER_INTERNAL_NETWORK=nixway-internal

# Platform app domains (deployed apps' public URLs)
# DOMAIN_BASE_DOMAIN is the suffix for auto-generated app domains, e.g. an app
# resolves to <app>-<project>-<team>.<base>. When CLOUDFLARE_API_TOKEN is set,
# each deploy upserts a Cloudflare A record for that name -> the serving node's
# public IP (edge LB IP in edge-mode clusters), and app deletion removes it.
# Leave the token blank to fall back to *.nip.io (the IP is baked into the
# hostname, no DNS setup needed) — good for local/dev.
NIXWAY_DOMAIN_BASE_DOMAIN=apps.nixway.dev
# API token with Zone:DNS:Edit on the nixway.dev zone (create at
# https://dash.cloudflare.com/profile/api-tokens).
NIXWAY_CLOUDFLARE_API_TOKEN=
# Optional: explicit zone ID. Resolved automatically from the base domain's
# registrable part (e.g. nixway.dev) when left blank.
NIXWAY_CLOUDFLARE_ZONE_ID=
# true = orange-cloud records (Cloudflare proxies + terminates TLS at the edge;
# origin stays HTTP). NOTE: free Universal SSL only covers nixway.dev and
# *.nixway.dev (one level) — for proxied *.apps.nixway.dev you need Advanced
# Certificate Manager, or set the base domain to nixway.dev to stay free.
NIXWAY_CLOUDFLARE_PROXIED=true

# Marketing site (apps/site)
# NIXWAY_MARKETING_DOMAIN is the hostname Traefik routes to the site
# (e.g. nixway.dev). Leave empty for localhost-only.
# NIXWAY_CONSOLE_URL is server-rendered into the site's "Sign in" /
# "Start free" links so they point at the live operator console.
NIXWAY_MARKETING_DOMAIN=
NIXWAY_CONSOLE_URL=https://console.nixway.dev

# Crypto (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
NIXWAY_CRYPTO_MASTER_KEY=

# Auth
NIXWAY_AUTH_BCRYPT_COST=12
NIXWAY_AUTH_SESSION_TTL=24h

# Email
# Driver: one of console (default, logs to stdout), smtp, or resend.
NIXWAY_EMAIL_DRIVER=console
# Verified sender address. With Resend, use "Display Name <addr@domain>".
NIXWAY_EMAIL_FROM=noreply@nixway.dev
NIXWAY_EMAIL_BASE_URL=http://localhost:5173
# SMTP driver:
# NIXWAY_EMAIL_SMTP_HOST=
# NIXWAY_EMAIL_SMTP_PORT=587
# NIXWAY_EMAIL_SMTP_USER=
# NIXWAY_EMAIL_SMTP_PASS=
# Resend driver: API key from https://resend.com/api-keys (re_…).
# Required when NIXWAY_EMAIL_DRIVER=resend; ignored otherwise.
# NIXWAY_EMAIL_API_KEY=

# Platform storage (MinIO by default; backs Phase 8.7 backups)
NIXWAY_MINIO_ROOT_USER=nixway
NIXWAY_MINIO_ROOT_PASSWORD=nixway-dev-secret-change-me
NIXWAY_PLATFORMSTORAGE_ENDPOINT=http://minio:9000
NIXWAY_PLATFORMSTORAGE_BUCKET=nixway-backups
NIXWAY_PLATFORMSTORAGE_REGION=us-east-1
NIXWAY_PLATFORMSTORAGE_USESSL=false
NIXWAY_PLATFORMSTORAGE_PROVIDER=minio
NIXWAY_PLATFORMSTORAGE_ACCESSKEY=nixway
NIXWAY_PLATFORMSTORAGE_SECRETKEY=nixway-dev-secret-change-me

# Observability
NIXWAY_OBSERVABILITY_VICTORIA_METRICS_URL=http://victoria-metrics:8428
NIXWAY_OBSERVABILITY_VMAGENT_URL=http://vmagent:8429
NIXWAY_OBSERVABILITY_VMAGENT_CONFIG_PATH=/etc/vmagent/prometheus.yml

# Control-plane observability stack (Grafana + Loki + Alloy + exporters).
# Opt-in: set to true to deploy it. Grafana is served at NIXWAY_GRAFANA_DOMAIN
# behind Traefik (defaults to grafana.<NIXWAY_PUBLIC_DOMAIN>). The admin
# password is generated into .env on first deploy if left blank.
NIXWAY_OBSERVABILITY_ENABLED=false
NIXWAY_GRAFANA_DOMAIN=
NIXWAY_GRAFANA_ADMIN_PASSWORD=
# Worker metrics listen address (Prometheus /metrics); rarely needs changing.
NIXWAY_WORKER_METRICS_ADDR=:8090
